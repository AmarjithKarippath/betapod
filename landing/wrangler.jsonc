{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betapod-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "routes": [
    { "pattern": "betapod.io", "custom_domain": true },
    // Both redirected by next.config.mjs (to betapod.io / app.betapod.io).
    { "pattern": "www.betapod.io", "custom_domain": true },
    { "pattern": "www.app.betapod.io", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
